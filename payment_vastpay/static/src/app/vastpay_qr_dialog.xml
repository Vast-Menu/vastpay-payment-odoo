<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="payment_vastpay.VastPayQRDialog">
        <Dialog>
            <t t-set-slot="header">
                <h4 class="modal-title">VastPay Payment</h4>
            </t>
            <div class="d-flex flex-column align-items-center text-center gap-2 p-2">
                <p class="mb-0">Scan the QR code to pay <strong t-esc="props.amountLabel"/></p>
                <img t-att-src="props.qrImage" alt="VastPay QR"
                     style="width:260px;height:260px;"/>
                <small class="text-muted">Waiting for payment confirmation…</small>
                <a t-att-href="props.paymentUrl" target="_blank" class="small">
                    Open payment page
                </a>
            </div>
            <t t-set-slot="footer">
                <button class="btn btn-secondary" t-on-click="cancel">Cancel</button>
            </t>
        </Dialog>
    </t>

</templates>
