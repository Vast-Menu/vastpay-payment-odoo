<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_payment_method_view_form_vastpay" model="ir.ui.view">
        <field name="name">pos.payment.method.form.vastpay</field>
        <field name="model">pos.payment.method</field>
        <field name="inherit_id" ref="point_of_sale.pos_payment_method_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_provider']" position="after">
                <field name="vastpay_provider_id"
                       invisible="payment_provider != 'vastpay'"
                       required="payment_provider == 'vastpay'"/>
            </xpath>
        </field>
    </record>

</odoo>
