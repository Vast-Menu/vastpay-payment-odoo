<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="pos_config_view_form_vastpay" model="ir.ui.view">
        <field name="name">pos.config.form.vastpay</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@class='oe_title'][@id='title']" position="after">
                <group string="VastPay" name="vastpay">
                    <field name="vastpay_table_id"/>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
