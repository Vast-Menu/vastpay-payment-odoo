<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_payment_form_vastpay" model="ir.ui.view">
        <field name="name">pos.payment.form.vastpay</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <field name="transaction_id" position="after">
                <field name="vastpay_payment_type" invisible="not vastpay_payment_type"/>
                <field name="vastpay_payment_method" invisible="not vastpay_payment_method"/>
            </field>
        </field>
    </record>
</odoo>
